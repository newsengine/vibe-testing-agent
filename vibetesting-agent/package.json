{
  "name": "vibetesting-agent",
  "version": "0.2.0",
  "private": true,
  "description": "VibeTesting Agent — hosted security scans for vibe-coded apps ($25 weekly / $100 daily / $250 every commit). WorkOS + Stripe. Powered by vibetesting-agent.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply vibetesting-agent --local",
    "db:migrate:remote": "wrangler d1 migrations apply vibetesting-agent --remote",
    "worker": "tsx src/worker.ts",
    "mcp": "tsx mcp/src/index.ts",
    "mcp:install": "npm install --prefix mcp"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@workos-inc/node": "^10.9.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "iron-session": "^8.0.4",
    "jose": "^6.2.3",
    "nanoid": "^5.1.16",
    "next": "^16.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.3.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "wrangler": "^4.151.1"
  }
}
