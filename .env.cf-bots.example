# Copy to a chmod-600 file outside git and `source` it. Never commit real secrets.
# Host gates (src/cf-bypass-headers.ts): nothing is sent until you list your own hosts.
#   x-smoke-key -> hosts in VTA_SMOKE_KEY_HOSTS
#   CF-Access-* -> hosts in VTA_CF_ACCESS_HOSTS
# Syntax: comma-separated; `example.com` is exact, `*.example.com` matches subdomains.
# Manual curl example:
#   --header "x-smoke-key: $CF_SMOKE_KEY"
#   --header "CF-Access-Client-Id: $CF_ACCESS_CLIENT_ID"
#   --header "CF-Access-Client-Secret: $CF_ACCESS_CLIENT_SECRET"
VTA_SMOKE_KEY_HOSTS=
VTA_CF_ACCESS_HOSTS=
CF_SMOKE_KEY=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
