{
  "name": "vibetesting-agent",
  "version": "0.6.1",
  "description": "Open-source black-box security scanner for deployed web apps: leaked API keys in JS bundles, exposed .env/.git/config, missing security headers, broken links, SEO, accessibility and performance gaps, all from a URL. Plus white-box multi-tenant and IDOR test helpers.",
  "type": "module",
  "bin": {
    "vibetesting-agent": "dist/cli.js",
    "vta": "dist/cli.js",
    "anal-probe": "dist/cli.js",
    "security-kit": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "templates",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "probe": "node --experimental-strip-types src/cli.ts",
    "catalog": "npm run build && node scripts/gen-catalog.mjs",
    "update-vuln-db": "node scripts/update-vuln-db.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run build && node --experimental-strip-types --test 'tests/**/*.test.ts'",
    "test:fixtures": "npm run build && node --experimental-strip-types --test tests/fixture-coverage.test.ts",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "security",
    "scanner",
    "security-scanner",
    "cli",
    "vibetesting-agent",
    "vibe-coding",
    "secrets-detection",
    "owasp",
    "security-headers",
    "csp",
    "seo",
    "accessibility",
    "a11y",
    "broken-links",
    "idor",
    "multi-tenant",
    "sarif",
    "ci"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newsengine/vibe-testing-agent.git"
  },
  "bugs": {
    "url": "https://github.com/newsengine/vibe-testing-agent/issues"
  },
  "homepage": "https://github.com/newsengine/vibe-testing-agent#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.63.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
